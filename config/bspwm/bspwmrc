#!/bin/sh

# Hotkey daemon
pgrep -x sxhkd > /dev/null || sxhkd &

# Desktops (I..X on the primary monitor; sxhkd maps super+{1-9,0} to them).
# For multi-monitor setups, configure your outputs with xrandr here first.
bspc monitor -d I II III IV V VI VII VIII IX X

# General
bspc config border_width         2
bspc config window_gap           12
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true

# Window rules
bspc rule -a Gimp state=floating follow=on
bspc rule -a mplayer2 state=floating
bspc rule -a Screenkey manage=off
bspc rule -a Tk state=floating

# Wallpaper: drop an image at ~/.config/bspwm/wallpaper.{png,jpg}
wallpaper="$(ls ~/.config/bspwm/wallpaper.* 2> /dev/null | head -n 1)"
if [ -n "$wallpaper" ] && command -v feh > /dev/null; then
  feh --no-fehbg --bg-fill "$wallpaper"
else
  xsetroot -solid "#1e1e2e" &
fi

# Cursor
xsetroot -cursor_name left_ptr &

# Bar, compositor, notifications and polkit agent (only present with --standard)
command -v polybar > /dev/null && ~/.config/polybar/launch.sh &
if command -v picom > /dev/null; then
  pgrep -x picom > /dev/null || picom --config ~/.config/picom/picom.conf &
fi
if command -v dunst > /dev/null; then
  pgrep -x dunst > /dev/null || dunst &
fi
for agent in /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do
  if [ -x "$agent" ]; then
    pgrep -f polkit-mate-authentication-agent-1 > /dev/null || "$agent" &
    break
  fi
done
