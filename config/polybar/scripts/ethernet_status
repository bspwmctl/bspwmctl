#!/bin/sh

# Print the local IP of the interface used for the default route

iface="$(ip route show default 2> /dev/null | awk '{print $5; exit}')"
ip="$(ip -4 -o addr show dev "$iface" 2> /dev/null | awk '{split($4, a, "/"); print a[1]; exit}')"

if [ -n "$ip" ]; then
  echo "%{F#2495e7} %{F#ffffff}$ip"
else
  echo "%{F#808080} Disconnected"
fi
