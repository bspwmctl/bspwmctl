print_version() {
  echo "bspwmctl $VERSION"
}


check_os() {
  local id

  if [[ -f /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
  else
    die "Could not detect distro. /etc/os-release does not exist."
  fi

  DISTRO_ID="${ID,,}"
  DISTRO_FAMILY=""

  # Derivatives (Linux Mint, Pop!_OS, Garuda, Nobara...) are detected through ID_LIKE
  for id in ${ID,,} ${ID_LIKE:-}; do
    case "${id,,}" in
      ubuntu)       DISTRO_FAMILY="ubuntu"; break ;;
      debian)       DISTRO_FAMILY="debian"; break ;;
      arch)         DISTRO_FAMILY="arch";   break ;;
      fedora)       DISTRO_FAMILY="fedora"; break ;;
    esac
  done

  # Kali and Parrot only declare ID_LIKE=debian, but match their own IDs explicitly too
  case "$DISTRO_ID" in
    kali|parrot)            DISTRO_FAMILY="debian" ;;
    manjaro|endeavouros)    DISTRO_FAMILY="arch" ;;
  esac

  [[ -n "$DISTRO_FAMILY" ]] || die "Unsupported distro: ${PRETTY_NAME:-$DISTRO_ID}. Supported: Debian, Ubuntu, Arch, Fedora and their derivatives."

  case "$DISTRO_ID" in
    ubuntu|debian|kali|parrot|arch|manjaro|endeavouros|fedora) ;;
    *) warn "${PRETTY_NAME:-$DISTRO_ID} is not tested, treating it as $DISTRO_FAMILY." ;;
  esac
}



set_packages() {
  case "$DISTRO_FAMILY" in
    debian|ubuntu)
      PKG_MANAGER="apt"
      PKGS_MINIMAL=(bspwm sxhkd kitty rofi feh x11-xserver-utils fontconfig diffutils)
      PKGS_STANDARD=(polybar picom dunst libnotify-bin i3lock flameshot brightnessctl
                     pavucontrol pulseaudio-utils xclip papirus-icon-theme mate-polkit
                     zsh zsh-autosuggestions zsh-syntax-highlighting)
      PKGS_FULL=(thunar btop mpv zathura zathura-pdf-poppler network-manager-gnome)
      # Debian ships firefox-esr; Ubuntu-based distros already include a Firefox
      # (a snap on Ubuntu itself), so it is not installed there
      if [[ "$DISTRO_FAMILY" == debian ]]; then
        PKGS_FULL+=(firefox-esr)
      fi
      ;;

    arch)
      PKG_MANAGER="pacman"
      PKGS_MINIMAL=(bspwm sxhkd kitty rofi feh xorg-xsetroot fontconfig diffutils)
      PKGS_STANDARD=(polybar picom dunst libnotify i3lock flameshot brightnessctl
                     pavucontrol libpulse xclip papirus-icon-theme mate-polkit
                     zsh zsh-autosuggestions zsh-syntax-highlighting)
      PKGS_FULL=(thunar btop mpv zathura zathura-pdf-poppler nm-connection-editor firefox)
      ;;

    fedora)
      PKG_MANAGER="dnf"
      PKGS_MINIMAL=(bspwm sxhkd kitty rofi feh xsetroot fontconfig diffutils)
      PKGS_STANDARD=(polybar picom dunst libnotify i3lock flameshot brightnessctl
                     pavucontrol pulseaudio-utils xclip papirus-icon-theme mate-polkit
                     zsh zsh-autosuggestions zsh-syntax-highlighting)
      PKGS_FULL=(Thunar btop mpv zathura zathura-pdf-poppler nm-connection-editor firefox)
      ;;

    *)
      die "Unsupported distro family: $DISTRO_FAMILY"
      ;;
  esac
}


install_packages() {
  log "Installing packages with $PKG_MANAGER: $*"

  case "$PKG_MANAGER" in
    apt)
      sudo apt-get update
      sudo apt-get install -y "$@"
      ;;
    pacman)
      # Arch does not support partial upgrades, so sync and upgrade together
      sudo pacman -Syu --noconfirm --needed "$@"
      ;;
    dnf)
      sudo dnf install -y "$@"
      ;;
  esac

  success "Packages installed successfully."
}


# Binaries built from source by bspwmctl <= 0.1.0 live in /usr/local/bin and
# shadow the distro packages, so warn about them.
check_source_builds() {
  local bin

  for bin in bspwm bspc sxhkd polybar polybar-msg picom; do
    if [[ -e "/usr/local/bin/$bin" ]]; then
      warn "/usr/local/bin/$bin (built from source) takes precedence over the $PKG_MANAGER package. Remove it to use the packaged version."
    fi
  done
}



# Copy a file or directory under $HOME into this run's backup directory,
# keeping its path relative to $HOME (e.g. .config/bspwm, .zshrc)
backup_path() {
  local path="$1"
  local rel="${path#"$HOME"/}"

  if [[ -z "$BACKUP_DIR" ]]; then
    BACKUP_DIR="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)"
    while [[ -e "$BACKUP_DIR" ]]; do BACKUP_DIR="$BACKUP_DIR-1"; done
    mkdir -p "$BACKUP_DIR"
    log "Saving current configs to $BACKUP_DIR"
  fi

  mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
  cp -a "$path" "$BACKUP_DIR/$rel"
}


# True if copying $1 over $2 would change any existing file.
# Without diff we can't tell, so assume it would (better an extra backup).
would_overwrite() {
  [[ -e "$2" ]] || return 1
  command -v diff > /dev/null || return 0
  # LC_ALL=C: diff messages are translated otherwise
  { LC_ALL=C diff -rq "$1" "$2" 2> /dev/null || true; } | grep -qE ' differ$|while file'
}


report_backup() {
  if [[ -n "$BACKUP_DIR" ]]; then
    warn "Your previous configs were saved. Restore them with: bspwmctl restore $(basename "$BACKUP_DIR")"
  fi
}


configure() {
  local target="$1"
  local config_dir="$HOME/.config/$target"

  echo -e "${GREEN}⚙️ Configuring ${target^^}...${NC}"

  [[ -d "$CONFIG_SRC/$target" ]] || die "Error: configs not found in $CONFIG_SRC/$target"

  if would_overwrite "$CONFIG_SRC/$target" "$config_dir"; then
    backup_path "$config_dir"
  fi

  mkdir -p "$config_dir"
  cp -rf "$CONFIG_SRC/$target/"* "$config_dir/"

  if [[ -f "$config_dir/${target}rc" ]]; then
    chmod +x "$config_dir/${target}rc" || true
  fi

  success "Configs copied for $target"
  echo
}


install_fonts() {
  local fonts_dir="$XDG_DATA_HOME/fonts/bspwmctl"

  log "Installing fonts..."

  mkdir -p "$fonts_dir"
  cp -f "$CONFIG_SRC/polybar/fonts/"* "$fonts_dir/"
  fc-cache -f "$fonts_dir" > /dev/null

  success "Fonts installed in $fonts_dir"
}


setup_zsh() {
  local zsh_path user

  zsh_path="$(command -v zsh)" || { warn "zsh not found, skipping shell setup."; return; }
  user="$(id -un)"

  log "Setting up zsh..."

  if would_overwrite "$CONFIG_SRC/zsh/zshrc" "$HOME/.zshrc"; then
    backup_path "$HOME/.zshrc"
  fi
  cp -f "$CONFIG_SRC/zsh/zshrc" "$HOME/.zshrc"

  if [[ "$(getent passwd "$user" | cut -d: -f7)" != "$zsh_path" ]]; then
    sudo usermod -s "$zsh_path" "$user"
    success "Default shell changed to zsh (takes effect on next login)."
  fi

  success "zsh configured."
}


get_current_theme() {
  local current_file="$BSPWMCTL_DIR/.current_theme"

  if [[ -f "$current_file" ]]; then
    cat "$current_file"
  else
    echo "default"
  fi
}


is_known_theme() {
  local theme
  for theme in "${THEMES[@]}"; do
    [[ "$theme" == "$1" ]] && return 0
  done
  return 1
}


set_current_theme() {
  local theme="$1"
  mkdir -p "$BSPWMCTL_DIR"
  echo "$theme" > "$BSPWMCTL_DIR/.current_theme"
}


cmd_theme() {
  local theme="${1:-}"

  if [[ -z "$theme" ]]; then
    local current
    current="$(get_current_theme)"
    log "Current theme: $current"

    echo "Available themes:"
    printf '  %s\n' "${THEMES[@]}"
    return
  fi

  is_known_theme "$theme" || die "Unknown theme: $theme. Available: ${THEMES[*]}"

  # apply theme logic
  log "Applying theme: $theme"

  case "$theme" in
    default)
      install_fonts
      configure "bspwm"
      configure "sxhkd"
      configure "kitty"
      # Only configure optional components that are installed (--standard)
      command -v polybar > /dev/null && configure "polybar"
      command -v picom > /dev/null && configure "picom"
      command -v dunst > /dev/null && configure "dunst"
      ;;
  esac

  set_current_theme "$theme"
  success "Theme applied: $theme"
}



parse_install_args() {
  MODE="minimal"
  NO_DEP=false
  THEME="default"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --minimal)
        MODE="minimal"
        shift
        ;;
      --standard)
        MODE="standard"
        shift
        ;;
      --all)
        MODE="full"
        shift
        ;;
      --no-dep)
        NO_DEP=true
        shift
        ;;
      --theme)
        [[ -n "${2:-}" ]] || die "--theme requires a theme name"
        is_known_theme "$2" || die "Unknown theme: $2. Available: ${THEMES[*]}"
        THEME="$2"
        shift 2
        ;;
      *)
        die "Unknown option: $1. Run 'bspwmctl help' for usage."
        ;;
    esac
  done
}


cmd_install() {
  parse_install_args "$@"

  check_os
  set_packages

  local packages=("${PKGS_MINIMAL[@]}")

  case "$MODE" in
    minimal)
      ;;
    standard)
      packages+=("${PKGS_STANDARD[@]}")
      ;;
    full)
      packages+=("${PKGS_STANDARD[@]}" "${PKGS_FULL[@]}")
      ;;
    *)
      die "Unknown install mode: $MODE"
      ;;
  esac

  if [ "$NO_DEP" = false ]; then
    install_packages "${packages[@]}"
  else
    warn "Skipping package installation (--no-dep). Make sure these are installed: ${packages[*]}"
  fi

  check_source_builds

  if [[ "$MODE" != minimal ]]; then
    setup_zsh
  fi

  cmd_theme "$THEME"

  success "Installation complete!"
  success "Log out and select the bspwm session in your login screen."
}


cmd_restore() {
  local id="${1:-}"
  local src item rel target

  if [[ -z "$id" ]]; then
    if [[ ! -d "$BACKUP_ROOT" ]] || [[ -z "$(ls -A "$BACKUP_ROOT")" ]]; then
      log "No backups found."
      return
    fi

    log "Available backups (newest last):"
    for src in "$BACKUP_ROOT"/*/; do
      src="${src%/}"
      echo "  $(basename "$src")  $(cd "$src" && ls -A .config 2> /dev/null | tr '\n' ' ')$([[ -e "$src/.zshrc" ]] && echo ".zshrc")"
    done
    echo
    echo "Restore one with: bspwmctl restore <backup>"
    return
  fi

  src="$BACKUP_ROOT/$id"
  [[ -n "$id" && "$id" != */* && -d "$src" ]] || die "Backup not found: $id"

  log "Restoring backup $id..."

  for item in "$src/.zshrc" "$src"/.config/*; do
    [[ -e "$item" ]] || continue
    rel="${item#"$src"/}"
    target="$HOME/$rel"

    # Keep the current state too, so a restore can be undone
    if [[ -e "$target" ]]; then
      backup_path "$target"
      rm -rf "$target"
    fi

    mkdir -p "$(dirname "$target")"
    cp -a "$item" "$target"
    success "Restored ~/$rel"
  done

  success "Backup $id restored."
}


cmd_uninstall() { die "Not implemented yet: uninstall"; }
cmd_update()    { die "Not implemented yet: update"; }



main() {
  local cmd="${1:-help}"
  shift || true

  # Configs go to the invoking user's $HOME; sudo is used only for packages
  if [[ $EUID -eq 0 && "$cmd" =~ ^(install|theme|restore)$ ]]; then
    die "Do not run 'bspwmctl $cmd' as root. Use a normal user."
  fi

  case "$cmd" in
    install)    cmd_install "$@" ;;
    uninstall)  cmd_uninstall "$@" ;;
    theme)      cmd_theme "$@" ;;
    restore)    cmd_restore "$@" ;;
    update)     cmd_update "$@" ;;
    help)       print_help ;;
    -h|--help)  print_help ;;
    version|-v|--version) print_version ;;
    *) die "Unknown command: $cmd. Run 'bspwmctl help' for usage." ;;
  esac

  report_backup
}

main "$@"
