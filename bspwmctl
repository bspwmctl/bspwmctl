#!/usr/bin/env bash

# bspwmctl – Opinionated bspwm desktop setup
# Author: lukatinarelli

set -Eeuo pipefail


# Hide cursor
tput civis 2> /dev/null || true


# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
NC='\033[0m'


# Global variables
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VERSION="0.2.0-beta.1"
REPO="bspwmctl/bspwmctl"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
THEMES=(default)
BSPWMCTL_DIR="$XDG_DATA_HOME/bspwmctl"

# One backup directory per run, created on the first overwritten file
BACKUP_ROOT="$BSPWMCTL_DIR/backups"
BACKUP_DIR=""

# What was in $HOME before bspwmctl first wrote to it, for uninstall
ORIGINALS="$BSPWMCTL_DIR/originals"

# Temporary download directory, removed on exit
TMP_DIR=""

# Bundled configs: next to the script when run from the repo, /usr/share when installed as a package
if [[ -d "$SCRIPT_DIR/config" ]]; then
  CONFIG_SRC="$SCRIPT_DIR/config"
else
  CONFIG_SRC="/usr/share/bspwmctl/config"
fi


log()     { echo -e "${BLUE}[*]${NC} $*"; }
success() { echo -e "${GREEN}[✔]${NC} $*"; }
warn()    { echo -e "${YELLOW}[!]${NC} $*"; }
die()     { echo -e "${RED}[✖]${NC} $*" >&2; exit 1; }



ctrl_c() {
  echo
  warn "Interrupted by user"
  exit 130
}

trap ctrl_c INT
trap 'tput cnorm 2> /dev/null || true; [[ -z "$TMP_DIR" ]] || rm -rf "$TMP_DIR"' EXIT



print_help() {
  cat <<'EOF'

