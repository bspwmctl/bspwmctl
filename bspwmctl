print_version() {
  echo "bspwmctl $VERSION"
}


check_os() {
  # os-release also sets VERSION, which would replace bspwmctl's own
  local id ID ID_LIKE PRETTY_NAME VERSION

  if [[ -f /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
  else
    die "Could not detect distro. /etc/os-release does not exist."
  fi

  DISTRO_ID="${ID,,}"
  DISTRO_FAMILY=""

  # Derivatives (Linux Mint, Pop!_OS, Garuda, Nobara...) are detected through ID_LIKE
  for id in ${ID,,} ${ID_LIKE:-}; do
    case "${id,,}" in
      ubuntu)       DISTRO_FAMILY="ubuntu"; break ;;
      debian)       DISTRO_FAMILY="debian"; break ;;
      arch)         DISTRO_FAMILY="arch";   break ;;
      fedora)       DISTRO_FAMILY="fedora"; break ;;
    esac
  done

  # Kali and Parrot only declare ID_LIKE=debian, but match their own IDs explicitly too
  case "$DISTRO_ID" in
    kali|parrot)            DISTRO_FAMILY="debian" ;;
    manjaro|endeavouros)    DISTRO_FAMILY="arch" ;;
  esac

  [[ -n "$DISTRO_FAMILY" ]] || die "Unsupported distro: ${PRETTY_NAME:-$DISTRO_ID}. Supported: Debian, Ubuntu, Arch, Fedora and their derivatives."

  case "$DISTRO_ID" in
    ubuntu|debian|kali|parrot|arch|manjaro|endeavouros|fedora) ;;
    *) warn "${PRETTY_NAME:-$DISTRO_ID} is not tested, treating it as $DISTRO_FAMILY." ;;
  esac
}



set_packages() {
  case "$DISTRO_FAMILY" in
    debian|ubuntu)
      PKG_MANAGER="apt"
      PKGS_MINIMAL=(bspwm sxhkd kitty rofi feh x11-xserver-utils fontconfig diffutils)
      PKGS_STANDARD=(polybar picom dunst libnotify-bin i3lock flameshot brightnessctl
                     pavucontrol pulseaudio-utils xclip papirus-icon-theme mate-polkit
                     zsh zsh-autosuggestions zsh-syntax-highlighting)
      PKGS_FULL=(thunar btop mpv zathura zathura-pdf-poppler network-manager-gnome)
      # Debian ships firefox-esr; Ubuntu-based distros already include a Firefox
      # (a snap on Ubuntu itself), so it is not installed there
      if [[ "$DISTRO_FAMILY" == debian ]]; then
        PKGS_FULL+=(firefox-esr)
      fi
      ;;

    arch)
      PKG_MANAGER="pacman"
      PKGS_MINIMAL=(bspwm sxhkd kitty rofi feh xorg-xsetroot fontconfig diffutils)
      PKGS_STANDARD=(polybar picom dunst libnotify i3lock flameshot brightnessctl
                     pavucontrol libpulse xclip papirus-icon-theme mate-polkit
                     zsh zsh-autosuggestions zsh-syntax-highlighting)
      PKGS_FULL=(thunar btop mpv zathura zathura-pdf-poppler nm-connection-editor firefox)
      ;;

    fedora)
      PKG_MANAGER="dnf"
      PKGS_MINIMAL=(bspwm sxhkd kitty rofi feh xsetroot fontconfig diffutils)
      PKGS_STANDARD=(polybar picom dunst libnotify i3lock flameshot brightnessctl
                     pavucontrol pulseaudio-utils xclip papirus-icon-theme mate-polkit
                     zsh zsh-autosuggestions zsh-syntax-highlighting)
      PKGS_FULL=(Thunar btop mpv zathura zathura-pdf-poppler nm-connection-editor firefox)
      ;;

    *)
      die "Unsupported distro family: $DISTRO_FAMILY"
      ;;
  esac
}


install_packages() {
  log "Installing packages with $PKG_MANAGER: $*"

  case "$PKG_MANAGER" in
    apt)
      sudo apt-get update
      sudo apt-get install -y "$@"
      ;;
    pacman)
      # Arch does not support partial upgrades, so sync and upgrade together
      sudo pacman -Syu --noconfirm --needed "$@"
      ;;
    dnf)
      sudo dnf install -y "$@"
      ;;
  esac

  success "Packages installed successfully."
}


# Binaries built from source by bspwmctl <= 0.1.0 live in /usr/local/bin and
# shadow the distro packages, so warn about them.
check_source_builds() {
  local bin

  for bin in bspwm bspc sxhkd polybar polybar-msg picom; do
    if [[ -e "/usr/local/bin/$bin" ]]; then
      warn "/usr/local/bin/$bin (built from source) takes precedence over the $PKG_MANAGER package. Remove it to use the packaged version."
    fi
  done
}



# Copy a file or directory under $HOME into this run's backup directory,
# keeping its path relative to $HOME (e.g. .config/bspwm, .zshrc)
backup_path() {
  local path="$1"
  local rel="${path#"$HOME"/}"

  if [[ -z "$BACKUP_DIR" ]]; then
    BACKUP_DIR="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)"
    while [[ -e "$BACKUP_DIR" ]]; do BACKUP_DIR="$BACKUP_DIR-1"; done
    mkdir -p "$BACKUP_DIR"
    log "Saving current configs to $BACKUP_DIR"
  fi

  # Already saved in this run
  if [[ -e "$BACKUP_DIR/$rel" || -L "$BACKUP_DIR/$rel" ]]; then
    return
  fi

  mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
  cp -a "$path" "$BACKUP_DIR/$rel"
}


# True if copying $1 over $2 would change any existing file.
# Without diff we can't tell, so assume it would (better an extra backup).
would_overwrite() {
  [[ -e "$2" ]] || return 1
  command -v diff > /dev/null || return 0
  # LC_ALL=C: diff messages are translated otherwise
  { LC_ALL=C diff -rq "$1" "$2" 2> /dev/null || true; } | grep -qE ' differ$|while file'
}


# $ORIGINALS has one "<key>\t<value>" line per path, written the first time
# bspwmctl touches it: "<path relative to $HOME>\t<backup holding the original>",
# or "-" as value if it didn't exist, plus "@shell\t<previous login shell>".
get_original() {
  if [[ -f "$ORIGINALS" ]]; then
    awk -F'\t' -v key="$1" '$1 == key { print $2; exit }' "$ORIGINALS"
  fi
}


# Installs made before $ORIGINALS existed (0.2.0-beta.1) can't tell the
# originals from bspwmctl's own configs anymore, so they are not tracked
tracking_originals() {
  [[ -f "$ORIGINALS" || ! -f "$BSPWMCTL_DIR/.current_theme" ]]
}


set_original() {
  if tracking_originals && [[ -z "$(get_original "$1")" ]]; then
    mkdir -p "$BSPWMCTL_DIR"
    printf '%s\t%s\n' "$1" "$2" >> "$ORIGINALS"
  fi
}


# Call before bspwmctl writes a path under $HOME
remember_original() {
  local path="$1"
  local rel="${path#"$HOME"/}"

  if ! tracking_originals || [[ -n "$(get_original "$rel")" ]]; then
    return
  fi

  if [[ -e "$path" ]]; then
    backup_path "$path"
    set_original "$rel" "$(basename "$BACKUP_DIR")"
  else
    set_original "$rel" "-"
  fi
}


report_backup() {
  if [[ -n "$BACKUP_DIR" ]]; then
    warn "Your previous configs were saved. Restore them with: bspwmctl restore $(basename "$BACKUP_DIR")"
  fi
}


configure() {
  local target="$1"
  local config_dir="$HOME/.config/$target"

  echo -e "${GREEN}⚙️ Configuring ${target^^}...${NC}"

  [[ -d "$CONFIG_SRC/$target" ]] || die "Error: configs not found in $CONFIG_SRC/$target"

  remember_original "$config_dir"
  if would_overwrite "$CONFIG_SRC/$target" "$config_dir"; then
    backup_path "$config_dir"
  fi

  mkdir -p "$config_dir"
  cp -rf "$CONFIG_SRC/$target/"* "$config_dir/"

  if [[ -f "$config_dir/${target}rc" ]]; then
    chmod +x "$config_dir/${target}rc" || true
  fi

  success "Configs copied for $target"
  echo
}


install_fonts() {
  local fonts_dir="$XDG_DATA_HOME/fonts/bspwmctl"

  log "Installing fonts..."

  mkdir -p "$fonts_dir"
  cp -f "$CONFIG_SRC/polybar/fonts/"* "$fonts_dir/"
  fc-cache -f "$fonts_dir" > /dev/null

  success "Fonts installed in $fonts_dir"
}


setup_zsh() {
  local zsh_path user current_shell

  zsh_path="$(command -v zsh)" || { warn "zsh not found, skipping shell setup."; return; }
  user="$(id -un)"

  log "Setting up zsh..."

  remember_original "$HOME/.zshrc"
  if would_overwrite "$CONFIG_SRC/zsh/zshrc" "$HOME/.zshrc"; then
    backup_path "$HOME/.zshrc"
  fi
  cp -f "$CONFIG_SRC/zsh/zshrc" "$HOME/.zshrc"

  current_shell="$(getent passwd "$user" | cut -d: -f7)"
  set_original "@shell" "$current_shell"

  if [[ "$current_shell" != "$zsh_path" ]]; then
    sudo usermod -s "$zsh_path" "$user"
    success "Default shell changed to zsh (takes effect on next login)."
  fi

  success "zsh configured."
}


get_current_theme() {
  local current_file="$BSPWMCTL_DIR/.current_theme"

  if [[ -f "$current_file" ]]; then
    cat "$current_file"
  else
    echo "default"
  fi
}


is_known_theme() {
  local theme
  for theme in "${THEMES[@]}"; do
    [[ "$theme" == "$1" ]] && return 0
  done
  return 1
}


set_current_theme() {
  local theme="$1"
  mkdir -p "$BSPWMCTL_DIR"
  echo "$theme" > "$BSPWMCTL_DIR/.current_theme"
}


cmd_theme() {
  local theme="${1:-}"

  if [[ -z "$theme" ]]; then
    local current
    current="$(get_current_theme)"
    log "Current theme: $current"

    echo "Available themes:"
    printf '  %s\n' "${THEMES[@]}"
    return
  fi

  is_known_theme "$theme" || die "Unknown theme: $theme. Available: ${THEMES[*]}"

  # apply theme logic
  log "Applying theme: $theme"

  case "$theme" in
    default)
      install_fonts
      configure "bspwm"
      configure "sxhkd"
      configure "kitty"
      # Only configure optional components that are installed (--standard)
      command -v polybar > /dev/null && configure "polybar"
      command -v picom > /dev/null && configure "picom"
      command -v dunst > /dev/null && configure "dunst"
      ;;
  esac

  set_current_theme "$theme"
  success "Theme applied: $theme"
}



parse_install_args() {
  MODE="minimal"
  NO_DEP=false
  THEME="default"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --minimal)
        MODE="minimal"
        shift
        ;;
      --standard)
        MODE="standard"
        shift
        ;;
      --all)
        MODE="full"
        shift
        ;;
      --no-dep)
        NO_DEP=true
        shift
        ;;
      --theme)
        [[ -n "${2:-}" ]] || die "--theme requires a theme name"
        is_known_theme "$2" || die "Unknown theme: $2. Available: ${THEMES[*]}"
        THEME="$2"
        shift 2
        ;;
      *)
        die "Unknown option: $1. Run 'bspwmctl help' for usage."
        ;;
    esac
  done
}


cmd_install() {
  parse_install_args "$@"

  check_os
  set_packages

  local packages=("${PKGS_MINIMAL[@]}")

  case "$MODE" in
    minimal)
      ;;
    standard)
      packages+=("${PKGS_STANDARD[@]}")
      ;;
    full)
      packages+=("${PKGS_STANDARD[@]}" "${PKGS_FULL[@]}")
      ;;
    *)
      die "Unknown install mode: $MODE"
      ;;
  esac

  if [ "$NO_DEP" = false ]; then
    install_packages "${packages[@]}"
  else
    warn "Skipping package installation (--no-dep). Make sure these are installed: ${packages[*]}"
  fi

  check_source_builds

  if [[ "$MODE" != minimal ]]; then
    setup_zsh
  fi

  cmd_theme "$THEME"

  success "Installation complete!"
  success "Log out and select the bspwm session in your login screen."
}


cmd_restore() {
  local id="${1:-}"
  local src item rel target

  if [[ -z "$id" ]]; then
    if [[ ! -d "$BACKUP_ROOT" ]] || [[ -z "$(ls -A "$BACKUP_ROOT")" ]]; then
      log "No backups found."
      return
    fi

    log "Available backups (newest last):"
    for src in "$BACKUP_ROOT"/*/; do
      src="${src%/}"
      echo "  $(basename "$src")  $(cd "$src" && ls -A .config 2> /dev/null | tr '\n' ' ')$([[ -e "$src/.zshrc" ]] && echo ".zshrc")"
    done
    echo
    echo "Restore one with: bspwmctl restore <backup>"
    return
  fi

  src="$BACKUP_ROOT/$id"
  [[ -n "$id" && "$id" != */* && -d "$src" ]] || die "Backup not found: $id"

  log "Restoring backup $id..."

  for item in "$src/.zshrc" "$src"/.config/*; do
    [[ -e "$item" ]] || continue
    rel="${item#"$src"/}"
    target="$HOME/$rel"

    # Keep the current state too, so a restore can be undone
    if [[ -e "$target" ]]; then
      backup_path "$target"
      rm -rf "$target"
    fi

    mkdir -p "$(dirname "$target")"
    cp -a "$item" "$target"
    success "Restored ~/$rel"
  done

  success "Backup $id restored."
}


# True if version $1 is newer than $2. As in deb/rpm/pacman, a pre-release
# (0.2.0-beta.1) is older than its release (0.2.0): sort -V puts "~" first.
version_gt() {
  local a="${1/-/\~}" b="${2/-/\~}"
  [[ "$a" != "$b" && "$(printf '%s\n' "$a" "$b" | sort -V | tail -n 1)" == "$a" ]]
}


# Newest release with a package ending in $1, printed as "<tag> <url>".
# Pre-releases only count if $2 is 1 (the installed version is one too).
latest_release() {
  local json

  json="$(curl -fsSL "https://api.github.com/repos/$REPO/releases?per_page=30")" || return 1

  grep -oE '"(tag_name|prerelease|browser_download_url)": *("[^"]*"|true|false)' <<< "$json" |
    awk -F'"' -v suffix="$1" -v allow_pre="$2" '
      $2 == "tag_name"   { tag = $4 }
      $2 == "prerelease" { pre = ($3 ~ /true/) }
      $2 == "browser_download_url" && (allow_pre || !pre) &&
        substr($4, length($4) - length(suffix) + 1) == suffix { print tag, $4; exit }
    '
}


cmd_update() {
  local reapply=false updated=false allow_pre=0 suffix latest tag url version pkg

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --configs)
        reapply=true
        shift
        ;;
      *)
        die "Unknown option: $1. Run 'bspwmctl help' for usage."
        ;;
    esac
  done

  # A clone of the repo is updated with git, not with packages
  [[ "$SCRIPT_DIR" == /usr/bin ]] || die "bspwmctl is running from $SCRIPT_DIR, not from a package. Update it with 'git pull'."
  command -v curl > /dev/null || die "curl is required to download updates."

  check_os
  set_packages

  case "$PKG_MANAGER" in
    apt)    suffix="_all.deb" ;;
    dnf)    suffix=".noarch.rpm" ;;
    pacman) suffix="-any.pkg.tar.zst" ;;
  esac

  if [[ "$VERSION" == *-* ]]; then
    allow_pre=1
  fi

  log "Checking for updates..."
  latest="$(latest_release "$suffix" "$allow_pre")" || die "Could not reach GitHub. Check your connection and try again."
  [[ -n "$latest" ]] || die "No release with a package for $PKG_MANAGER found."

  tag="${latest%% *}"
  url="${latest#* }"
  version="${tag#v}"

  if version_gt "$version" "$VERSION"; then
    log "Updating bspwmctl $VERSION → $version"

    TMP_DIR="$(mktemp -d)"
    # apt reads local packages as its unprivileged _apt user
    chmod 755 "$TMP_DIR"
    pkg="$TMP_DIR/${url##*/}"
    curl -fL --progress-bar -o "$pkg" "$url" || die "Download failed: $url"
    chmod 644 "$pkg"

    case "$PKG_MANAGER" in
      apt)    sudo apt-get install -y "$pkg" ;;
      dnf)    sudo dnf install -y "$pkg" ;;
      pacman) sudo pacman -U --noconfirm "$pkg" ;;
    esac

    updated=true
    success "bspwmctl updated to $version."
    echo "What's new: https://github.com/$REPO/releases/tag/$tag"
  else
    success "bspwmctl $VERSION is up to date."
  fi

  if [[ "$reapply" == true ]]; then
    # Run the installed (possibly new) version, so it applies its own configs
    /usr/bin/bspwmctl theme "$(get_current_theme)"
  elif [[ "$updated" == true ]]; then
    log "Your configs were not changed. To apply the new defaults (yours are backed up first): bspwmctl update --configs"
  fi
}


cmd_uninstall() {
  local assume_yes=false legacy=false answer rel target orig existed user shell_now shell_orig
  local paths=(.config/bspwm .config/sxhkd .config/kitty .config/polybar .config/picom .config/dunst .zshrc)
  local fonts_dir="$XDG_DATA_HOME/fonts/bspwmctl"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes)
        assume_yes=true
        shift
        ;;
      *)
        die "Unknown option: $1. Run 'bspwmctl help' for usage."
        ;;
    esac
  done

  if ! tracking_originals; then
    legacy=true
  fi

  echo "This removes the bspwmctl configs (~/.config/bspwm, sxhkd, kitty, polybar, picom,"
  echo "dunst and ~/.zshrc) and fonts, and puts back the configs you had before bspwmctl."
  echo "Everything removed is backed up first. Installed programs are not removed."
  echo

  if [[ "$assume_yes" == false ]]; then
    tput cnorm 2> /dev/null || true
    read -r -p "Continue? [y/N] " answer || answer=""
    tput civis 2> /dev/null || true

    if [[ ! "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]; then
      log "Cancelled."
      return
    fi
  fi

  for rel in "${paths[@]}"; do
    target="$HOME/$rel"
    orig="$(get_original "$rel")"

    # Not written by bspwmctl (e.g. ~/.config/polybar after --minimal): leave it alone.
    # Untracked installs can't know, so they remove everything (it's backed up).
    if [[ -z "$orig" && "$legacy" == false ]]; then
      continue
    fi

    existed=false
    if [[ -e "$target" || -L "$target" ]]; then
      existed=true
      backup_path "$target"
      rm -rf "$target"
    fi

    if [[ -n "$orig" && "$orig" != - && -e "$BACKUP_ROOT/$orig/$rel" ]]; then
      mkdir -p "$(dirname "$target")"
      cp -a "$BACKUP_ROOT/$orig/$rel" "$target"
      success "Restored your previous ~/$rel"
    elif [[ "$existed" == true ]]; then
      success "Removed ~/$rel"
    fi
  done

  if [[ -d "$fonts_dir" ]]; then
    rm -rf "$fonts_dir"
    fc-cache -f > /dev/null 2>&1 || true
    success "Removed fonts from $fonts_dir"
  fi

  user="$(id -un)"
  shell_now="$(getent passwd "$user" | cut -d: -f7)"
  shell_orig="$(get_original "@shell")"

  # Only undo the change to zsh, not a shell the user picked later
  if [[ "${shell_now##*/}" == zsh ]]; then
    if [[ -n "$shell_orig" && "$shell_orig" != "$shell_now" && -x "$shell_orig" ]]; then
      sudo usermod -s "$shell_orig" "$user"
      success "Login shell set back to $shell_orig (takes effect on next login)."
    elif [[ "$legacy" == true ]]; then
      warn "Your login shell is zsh. If bspwmctl changed it, go back to bash with: chsh -s /bin/bash"
    fi
  fi

  rm -f "$ORIGINALS" "$BSPWMCTL_DIR/.current_theme"

  success "bspwmctl configs removed."
  log "The installed programs (bspwm, kitty...) were kept. Backups stay in $BACKUP_ROOT"

  if command -v apt-get > /dev/null; then
    log "To remove bspwmctl itself: sudo apt remove bspwmctl"
  elif command -v pacman > /dev/null; then
    log "To remove bspwmctl itself: sudo pacman -R bspwmctl"
  elif command -v dnf > /dev/null; then
    log "To remove bspwmctl itself: sudo dnf remove bspwmctl"
  fi
}



main() {
  local cmd="${1:-help}"
  shift || true

  # Configs go to the invoking user's $HOME; sudo is used only for packages
  if [[ $EUID -eq 0 && "$cmd" =~ ^(install|theme|restore|update|uninstall)$ ]]; then
    die "Do not run 'bspwmctl $cmd' as root. Use a normal user."
  fi

  case "$cmd" in
    install)    cmd_install "$@" ;;
    uninstall)  cmd_uninstall "$@" ;;
    theme)      cmd_theme "$@" ;;
    restore)    cmd_restore "$@" ;;
    update)     cmd_update "$@" ;;
    help)       print_help ;;
    -h|--help)  print_help ;;
    version|-v|--version) print_version ;;
    *) die "Unknown command: $cmd. Run 'bspwmctl help' for usage." ;;
  esac

  report_backup
}

main "$@"
